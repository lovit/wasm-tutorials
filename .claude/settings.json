{
  "_comment": "읽기와 검사는 열어 두고, 되돌리기 어려운 일과 바깥으로 나가는 일은 개인 설정(.claude/settings.local.json)으로 미룬다. push 는 allow 에 없을 뿐 deny 는 아니다. deny 는 allow 를 이기므로 여기 넣으면 개인 설정으로도 풀 수 없다. 그리고 deny 는 접두사 매칭이라 완전한 방어선이 아니다. 예를 들어 Bash 로 파일을 읽으면 Read 의 deny 를 지나칠 수 있다. 실수를 줄이는 장치이지 악의를 막는 장치가 아니다.",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git remote -v)",
      "Bash(gh issue *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh api repos/*)",
      "Bash(gh api user*)",
      "Bash(mise run *)",
      "Bash(prek *)",
      "Bash(node *)",
      "Bash(uvx *)",
      "Bash(npx --yes prettier*)",
      "Bash(npx --yes markdownlint-cli2*)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard*)",
      "Bash(gh repo delete *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/.ssh/*)"
    ]
  }
}
